# Copiar a .env y ajustar los valores antes de ejecutar `docker compose up`.

# Base de datos
POSTGRES_USER=carrera
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=carrera

# Bus de mensajes (NATS)
# Contraseña del usuario "pasarela" en NATS.
NATS_PASARELA_PASSWORD=cambiar-esta-clave
# Par de claves (nkey de cuenta) para firmar las respuestas del auth callout.
# Generar con:
#   docker run --rm natsio/nats-box nk -gen account -pubout
# La primera línea (empieza por "SA") es la privada y la segunda (empieza por
# "A") la pública.
NATS_CALLOUT_SEED=
NATS_CALLOUT_ISSUER=

# Pasarela de API
PASARELA_PUERTO=8080
LONG_POLLING_TIMEOUT_MS=1000
SESION_WEB_TTL=12h
TOKEN_API_MAX_DIAS=7

# Motores de simulación (perfil "mundos")
# UUID y testigo que se obtienen al dar de alta cada mundo en la página web.
MUNDO_OVALO_UUID=
MUNDO_OVALO_TESTIGO=
MAX_ROBOTS=4
PASO_FISICA_HZ=60
ESTADO_MUNDO_HZ=30
LATIDO_S=2
PARADA_MOTORES_S=5
SALIDA_MUNDO_S=300
